# ops/.env.deploy — local deploy configuration.
# Copy to ops/.env.deploy (gitignored) and fill in real values.

DEPLOY_SSH=musikersuche@musikersuche.org
DEPLOY_PATH=/opt/screenie
DEPLOY_DOMAIN=auffi.app
DEPLOY_TURN_DOMAIN=turn.auffi.app

# Cluster mode — if set, the target host already has a Caddy reverse proxy
# on a shared Docker network. In cluster mode the deploy uses
# docker-compose.cluster.yml to disable our internal Caddy and attach
# screenie-backend to the named external network. Leave empty for a
# standalone deploy where our own Caddy binds 80/443.
CLUSTER_PROXY=

# Host-key pin for DEPLOY_SSH. Defaults to ops/known_hosts (committed, holds the
# musikersuche.org keys). Self-hosters: point this at a file produced by
# `ssh-keyscan <host>` after verifying the fingerprint — see ops/README.md § 1.
DEPLOY_KNOWN_HOSTS=
