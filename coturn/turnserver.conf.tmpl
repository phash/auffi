listening-port=3478
tls-listening-port=5349
# Bind explicitly. coturn's auto-detection picked only some Docker
# bridges on the IONOS VPS and skipped the public IPv4 directly bound
# to ens6 — which left STUN/TURN unreachable from the outside despite
# `network_mode: host`. Setting `listening-ip` forces the bind; setting
# `external-ip` also tells coturn the public address to advertise in
# relay candidates (matters for 1:1-NAT cloud topologies — harmless
# when the public IP is directly bound).
# Lines are stripped at entrypoint time when the env vars are unset.
listening-ip=${TURN_LISTENING_IP}
external-ip=${TURN_EXTERNAL_IP}
fingerprint
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}
realm=${TURN_REALM}
total-quota=100
# Per-credential allocation cap (per browser — makeCredentials mints a unique
# username per peer). A multi-homed client burns ~3 allocations per local
# interface address (UDP+TCP on :3478 + TLS on :5349), so the old cap of 12
# was reached at just 4 interfaces (WLAN v4+v6 / Ethernet / WSL-vEthernet /
# VPN on Windows is trivial) → spurious `486 Allocation Quota Reached` and a
# "connected but no picture" stall for relay-dependent users (gh #112). 50
# covers ~16 interface addresses while staying well under total-quota=100, so
# a stolen ≤1h-TTL credential still can't monopolise the pool.
user-quota=50
max-bps=5000000
lifetime=600
no-multicast-peers
# SSRF defence: coturn relays to ANY unicast peer address a client requests
# by default. Running with `network_mode: host` on the VPS, an attacker who
# obtains TURN credentials could otherwise relay to internal/loopback hosts
# (the backend, the co-located Matomo, the cloud metadata endpoint at
# 169.254.169.254, neighbouring cluster containers). Deny every special-use /
# private range so the relay can only ever reach the public internet — the
# legitimate WebRTC peer is always a public (NAT-reflexive) address, so this
# does not affect normal sessions (incl. same-LAN, which relays via public
# addresses). `no-loopback-peers` is kept for version-robustness alongside the
# explicit 127/8 + ::1 ranges.
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# IPv4-mapped IPv6 (::ffff:a.b.c.d): coturn evaluates a *mapped-form* peer in v6
# space, so this single block denies the mapped form of every private/metadata
# v4 target (e.g. ::ffff:169.254.169.254). It is the only rule that does — the
# plain v4 ranges above match native-v4-form peers only. Keeping it is safe: a
# real WebRTC candidate is always a native v4 or native v6 address, never an
# ::ffff-mapped one, so no legitimate peer is ever presented in the form this
# range matches. Verified on coturn 4.6.3: native-v4 public peers stay ALLOWED
# while ::ffff:<private> is DENIED.
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
# NB: never add a bare `denied-peer-ip=::` alongside these. coturn parses the
# unspecified address as match-ALL and denies every peer, public included, which
# silently breaks ALL relayed sessions (viewer symptom: "Verbindung steht, aber
# es kommt kein Bild an"). That line was the 2026-05-29 regression (commit
# 6198a5f); removed 2026-06-15 after reproducing it against coturn 4.6.3.
no-tlsv1
no-tlsv1_1
# Explicit cipher list: TLS 1.3 AEADs first, then TLS 1.2 AEAD suites.
# TLS 1.2 is kept for client compatibility; TLS 1.3-only would break
# some WebRTC stacks that negotiate DTLS 1.2 (RFC 8827 requires at
# least DTLS 1.2; DTLS 1.3 is not yet universally supported).
cipher-list="TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256"
# Cert files staged by entrypoint from the Caddy data volume.
# If files are missing (cert not yet issued), coturn refuses to start the
# TLS listener but plain UDP/TCP TURN on 3478 continues to work.
cert=/var/lib/turn/cert.pem
pkey=/var/lib/turn/key.pem
log-file=stdout
# DSGVO Art. 5(1)(e): `verbose` logs full client IPs to stdout, which Docker
# routes into a journal kept for 30+ days. A 10-minute TURN session does not
# justify that retention. Keep coturn at the default log level (no `verbose`)
# so we only get error + allocation summary events, no per-packet IP dumps.
