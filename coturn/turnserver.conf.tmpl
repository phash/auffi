listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}
realm=${TURN_REALM}
total-quota=100
user-quota=5000000
max-bps=5000000
lifetime=600
no-multicast-peers
no-tlsv1
no-tlsv1_1
cert=/etc/letsencrypt/live/${TURN_REALM}/fullchain.pem
pkey=/etc/letsencrypt/live/${TURN_REALM}/privkey.pem
log-file=stdout
verbose
