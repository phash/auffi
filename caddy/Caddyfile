    email m.roedig@gmail.com
}

screenie.mr-development.de {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://screenie.mr-development.de wss://turn.screenie.mr-development.de:5349; img-src 'self' data:; media-src 'self' blob:; frame-ancestors 'none';"
    }

    # Backend WebSocket signaling
    handle /signal {
        reverse_proxy backend:8080
    }

    # TURN credential endpoint
    handle /turn-credentials {
        reverse_proxy backend:8080
    }

    # Health + readiness probes
    handle /healthz {
        reverse_proxy backend:8080
    }
    handle /readyz {
        reverse_proxy backend:8080
    }

    # Viewer assets (hashed filenames — long-lived caching)
    handle /assets/* {
        root * /srv/viewer
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # SPA fallback — all other paths serve index.html
    handle {
        root * /srv/viewer
        try_files {path} /index.html
        file_server
    }
}
