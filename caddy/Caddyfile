{
    email m.roedig@gmail.com
    order rate_limit before basicauth
}

www.auffi.app {
    redir https://auffi.app{uri} permanent
}

auffi.app {
    encode zstd gzip

    header {
        # `>` prefix forces overwrite of any pre-existing value (Caddy's
        # default semantics is "set only if missing"). Required because
        # the cluster-Caddy's shared `import security_headers` snippet
        # ships X-Frame-Options=SAMEORIGIN + Referrer-Policy=
        # strict-origin-when-cross-origin first; without the override
        # the per-tenant values below are silently ignored and the
        # live response carries the weaker shared defaults (security-
        # review SEC-M1, 2026-05-17).
        >Strict-Transport-Security "max-age=31536000; includeSubDomains"
        >X-Frame-Options "DENY"
        >X-Content-Type-Options "nosniff"
        >Referrer-Policy "no-referrer"
        # SHA-256 hashes whitelist EVERY inline <script type="application/
        # ld+json"> block across all 20 served marketing pages (de + en):
        # SoftwareApplication / FAQPage / BreadcrumbList / HowTo structured
        # data on /, /en/, /impressum/, /datenschutz/, /download/,
        # /en/download/, /vergleich/, /en/compare/, /vergleich/teamviewer/,
        # /en/compare/teamviewer/, /vergleich/anydesk/, /en/compare/anydesk/,
        # /vergleich/rustdesk/, /en/compare/rustdesk/,
        # /vergleich/chrome-remote-desktop/,
        # /en/compare/chrome-remote-desktop/,
        # /vergleich/teamviewer-kommerzielle-nutzung/,
        # /en/compare/teamviewer-commercial-use/,
        # /bildschirm-teilen-ohne-installation/,
        # /en/screen-sharing-without-install/.
        # Source of truth for the page registry: viewer/tests/marketing-seo.test.ts
        # Each distinct
        # block needs its own hash — a single page edit changes one hash and
        # blocks that block until re-added (the 2026-05-29 SEO deploy added
        # 12 blocks without updating this header → all CSP-blocked until the
        # 2026-06-03 fix). Recompute the full set after any JSON-LD edit via:
        #   python3 -c "import re,hashlib,base64,glob; files=['viewer/index.html','viewer/en/index.html']+sorted(glob.glob('viewer/public/**/index.html',recursive=True)); print('\n'.join(sorted({'sha256-'+base64.b64encode(hashlib.sha256(m.encode()).digest()).decode() for f in files for m in re.findall(r'<script(?:\\s[^>]*)?>(.*?)</script>', open(f).read(), re.DOTALL) if m.strip() and 'src=' not in m[:60]})))"
        #
        # `https://musikersuche.org` is whitelisted in script-src and
        # connect-src so the self-hosted Matomo on the same VPS can load
        # matomo.js (dynamically injected by /matomo-consent.js after
        # the user opts in) and POST tracking pings. Matomo läuft seit
        # 2026-05-21 als externes /matomo-consent.js (Vanilla-JS in
        # viewer/public/) statt inline — Auslöser war das DSGVO/TTDSG-
        # Review: cookieless allein reicht der LfDI-Niedersachsen-
        # Auslegung nicht, ein Opt-in-Banner muss her. Matomos eigene
        # Validator-Heuristik findet die externe Variante per HEAD nicht
        # mehr — Site-ID + Tracker-URL stehen aber unverändert im JS,
        # also klappt die tatsächliche Tracking-POST unbeeinflusst.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://musikersuche.org 'sha256-1Ca7PrQHr64lR2Phk4/tVv2kJDt4ZvAqnSWFuFfWF6s=' 'sha256-259M2otC+vmSX3o8P92aJpfZajprC5ttsmTvjmvvLXI=' 'sha256-2rSZLtn6xf7Rju1xHnDSOmzPKGi2vnf1K4qbm3lz4+Y=' 'sha256-3OQh5AsCLGpND2NmzDv1kr3/hx2JIbSBqXwnX4VmuCE=' 'sha256-4/icptbkFrpdVy8FvQy4k0WGpyt6oZJi71vAv4+1FJs=' 'sha256-53TIsyeuI4VtnyFxS+aO+/DFKx8J3yRCLSMjCv0h6U0=' 'sha256-87UPhysPFQ3TDPNjhcPPFhE2olj+eRpANWHUzZ24Ofc=' 'sha256-BD/u1ofnBMgZgzVzkjrPoh2AtOIScNRs6QGYZIZKJzY=' 'sha256-ByUWEd3OPt5VtJmobvafkWmRBUYP1MDsiAgXESBcbJQ=' 'sha256-EsurmygBstR0IoeajKPxrVdcP44Vddl6SYK2I29vwBQ=' 'sha256-H9nW5hFZmHAYUkz4gxLyk7DTdv7RfXo3b0XnVH2+oAk=' 'sha256-IUsPxjmozifBW7iPJxvHR4hOIp/na30T69hokSNkjts=' 'sha256-JF1Ax1pRALRRMxRDaHQrFnQYwxyE9Uf/jkhlwipI+iA=' 'sha256-MqEkevZyYBJpjXIC0Xdyi8fWj0RxO8YzY7Iz8A7XMOI=' 'sha256-N5UqO5tA512wmndFDc5SxipvX6zrtr4UtIGdXB9jazE=' 'sha256-NER6sdBdCHFjuwd72YbvuXwIVtVlQQ9F82A6AXtkw7c=' 'sha256-NF9W69Mtpp930MPSb0PKzhvBFYYNoIR5skyVgT8hEjI=' 'sha256-OOJ4quBf5et40SGmtnhIY43DaaXmcPwIMa27j/AgzA0=' 'sha256-P1rF3X6WDBd836RaZ5faICnqQ0QeMnW2o0f5QKMf5O4=' 'sha256-PHRD/DvSjjmoS31i6l3LLz5yJJDgkLMsZbwXxQnh8FE=' 'sha256-PRnbfGAirq+alFb1k5eSQGqOhYwn+dowEZnAv1DPjfU=' 'sha256-PnYabrTFzSW2tqslaLuQLVCCAtzuOeFGCL7qLfGvZps=' 'sha256-UBsNylViEJBCSjVUY+s0BIOvePBox12cX8MBIXqd1RA=' 'sha256-UDdN/Ga4c/nFpWhIu4ddUb6ohmzYW3w5iiFjlSchzoo=' 'sha256-W66tZGCjSpJzZ+FKP8jsPwiZRnW7l+nlndwXbjRDEbg=' 'sha256-WJ8xHiU+vYyjrOFKCc1vZKoO4SIuWtuCuNJopDv/Oj8=' 'sha256-WuXn4qg8p85ahBTkIpM6hNEHakZWBevTGFlOyyVtxUw=' 'sha256-dDQdLiwV+2cI57HdpQuxCndBynv+FTOelezux8m+kug=' 'sha256-eKlM3kiCOj0JjaH7Kn9hdFlKj9Ao7cCcCtO+UMhY6fo=' 'sha256-gIUteYT/Gw4qnDW7bfyvPRLEZeMRcHB2qL9wPyKsp/U=' 'sha256-kSscQX18/vt6sObuJxSTDYbQNlHKpc40mA7pwz9mGP0=' 'sha256-kv+5Bm/XhxX30+DyeJgoxp+dpbnAnZapJJ7A79ELhu8=' 'sha256-mO/rzXGExSr1lByXYmdcIsmpn9f28Bu6QaRlWSx/qIs=' 'sha256-n2emUt+16oA3OypX3lnVrwVwh6ATykOwPkglQZN/8f8=' 'sha256-oMMyxGYEoTuRn7bNHlOnQBvy2pEji2UkCJixnsRRCeY=' 'sha256-qCeF+ZFDSqmeatEVXcrUrNC9TIC+kQRKLkT9vm+nhtw=' 'sha256-rxtXIhQhp6Nv7uDW5CG1cg5+mpl0HUNbLwKeWHK04KU=' 'sha256-v/BoDljC077J+Ix4q3t0EKcVcNqHTrPWPUCWGYCpH40=' 'sha256-xLHyd1q9FtMOhKhEfXmPaokM5KErXXtfR0GIzu9EMxE=' 'sha256-xe3p//8GQ0xBvPQWt4m1G4k0c4UO3+jWc0go6ES/Uww=' 'sha256-xgaC4T2SHDawXuucSr6rnaCLrOhJ4gWhPGV5oex1/yQ=' 'sha256-zX03y8qVxXFuucjOU0r7SeIUq+2Oxk0RflKytH/8afw='; style-src 'self'; connect-src 'self' https://musikersuche.org wss://auffi.app wss://turn.auffi.app:5349; img-src 'self' data:; media-src 'self' blob:; frame-ancestors 'none';"
    }

    # Bot prevention — Liste enthält NUR eindeutige Angreifer-/
    # Scrape-Tools, NICHT die generischen Substrings `bot`,
    # `crawler`, `spider`. Diese drei matchen jeden legit
    # Search-Engine-Crawler (Googlebot, bingbot, DuckDuckBot,
    # AhrefsBot, LinkedInBot, Twitterbot, facebookexternalhit …) und
    # haben in der ursprünglichen Fassung den 2026-05-14-SEO-Outage
    # ausgelöst — Search Console konnte nicht crawlen.
    # Excludes /healthz and /readyz so deploy-scripts using curl still work.
    @scrapers {
        header_regexp User-Agent (?i)(scrapy|wget|curl|headlesschrome|phantomjs|nikto|sqlmap|sqlninja|nmap|masscan|metasploit|dirbuster|nuclei|wpscan)
        not path /healthz
        not path /readyz
    }
    handle @scrapers {
        respond "Forbidden" 403
    }

    # Rate limiting per IP.
    # /signal (WebSocket) is excluded: the WS connection itself is long-lived
    # and app-level per-peer message limits apply inside the backend.
    # /turn-credentials has its own tighter zone (10 req/min, enforced by backend too).
    rate_limit {
        zone auffi_general {
            match {
                not path /signal
                not path /turn-credentials
            }
            key {remote_host}
            events 300
            window 1m
        }
        zone auffi_turn {
            match {
                path /turn-credentials
            }
            key {remote_host}
            events 10
            window 1m
        }
    }

    # Backend WebSocket signaling
    handle /signal {
        reverse_proxy backend:8080
    }

    # TURN credential endpoint
    handle /turn-credentials {
        reverse_proxy backend:8080
    }

    # gh #38: REST API for the dashboard (auth + me + devices +
    # admin). Same backend container as /signal — separate handle
    # block (not handle_path) so the /api prefix is preserved end-
    # to-end. Fastify routes are mounted as /api/auth, /api/devices,
    # /api/me, /api/admin etc.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # gh #38: dashboard SPA. Bundle is built with base="/dashboard/"
    # so internal asset references point at /dashboard/assets/...
    # The dashboard nginx sidecar serves the static dist; Caddy
    # strips /dashboard/ before proxying so nginx sees /assets/...
    handle_path /dashboard/* {
        reverse_proxy dashboard:80
    }
    # Normalise the no-slash /dashboard to /dashboard/. Caddy's
    # bare `handle /dashboard { redir … }` form did not fire next
    # to a `handle_path /dashboard/*` block (Caddy treated the
    # path as a non-matching path glob), so use the named-matcher
    # form which Caddy v2 documents explicitly.
    @dashboard_no_slash path /dashboard
    redir @dashboard_no_slash /dashboard/ permanent

    # Health + readiness probes
    handle /healthz {
        reverse_proxy backend:8080
    }
    handle /readyz {
        reverse_proxy backend:8080
    }

    # Viewer assets (hashed filenames — long-lived caching)
    handle /assets/* {
        root * /srv/viewer
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # SPA fallback — all other paths serve index.html
    handle {
        root * /srv/viewer
        try_files {path} /index.html
        file_server
    }
}
