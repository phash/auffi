{
    email m.roedig@gmail.com
    order rate_limit before basicauth
}

www.auffi.app {
    redir https://auffi.app{uri} permanent
}

auffi.app {
    encode zstd gzip

    header {
        # `>` prefix forces overwrite of any pre-existing value (Caddy's
        # default semantics is "set only if missing"). Required because
        # the cluster-Caddy's shared `import security_headers` snippet
        # ships X-Frame-Options=SAMEORIGIN + Referrer-Policy=
        # strict-origin-when-cross-origin first; without the override
        # the per-tenant values below are silently ignored and the
        # live response carries the weaker shared defaults (security-
        # review SEC-M1, 2026-05-17).
        #
        # This block is the reference set: the hand-maintained auffi.app
        # block in the cluster Caddyfile (/opt/caddyserver/Caddyfile) must
        # carry exactly these values, and a standalone self-host ships
        # this file as-is. Guard: ops/tests/caddyfile-headers.test.sh.
        >Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        >X-Frame-Options "DENY"
        >X-Content-Type-Options "nosniff"
        # "0" disables the legacy XSS auditor in the browsers that still
        # have one — its filtering introduced XS-leaks; CSP is the defence.
        >X-XSS-Protection "0"
        >Referrer-Policy "no-referrer"
        # The viewer never asks for location, microphone or camera —
        # screen capture is the sharer's job, the browser only plays it,
        # so getDisplayMedia (display-capture), WebUSB and the Payment
        # Request API are denied too.
        >Permissions-Policy "geolocation=(), microphone=(), camera=(), display-capture=(), usb=(), payment=()"
        # Own browsing-context group: a page we open or that opens us gets
        # no window handle (no opener-based tab-napping / XS-leaks). Nothing
        # here uses window.open or relies on window.opener.
        >Cross-Origin-Opener-Policy "same-origin"
        # SHA-256 hashes whitelist EVERY inline <script type="application/
        # ld+json"> block across all 20 served marketing pages (de + en):
        # SoftwareApplication / FAQPage / BreadcrumbList / HowTo structured
        # data on /, /en/, /impressum/, /datenschutz/, /download/,
        # /en/download/, /vergleich/, /en/compare/, /vergleich/teamviewer/,
        # /en/compare/teamviewer/, /vergleich/anydesk/, /en/compare/anydesk/,
        # /vergleich/rustdesk/, /en/compare/rustdesk/,
        # /vergleich/chrome-remote-desktop/,
        # /en/compare/chrome-remote-desktop/,
        # /vergleich/teamviewer-kommerzielle-nutzung/,
        # /en/compare/teamviewer-commercial-use/,
        # /bildschirm-teilen-ohne-installation/,
        # /en/screen-sharing-without-install/.
        # Source of truth for the page registry: viewer/tests/marketing-seo.test.ts
        # Each distinct
        # block needs its own hash — a single page edit changes one hash and
        # blocks that block until re-added (the 2026-05-29 SEO deploy added
        # 12 blocks without updating this header → all CSP-blocked until the
        # 2026-06-03 fix). Recompute the full set after any JSON-LD edit via:
        #   python3 -c "import re,hashlib,base64,glob; files=['viewer/index.html','viewer/en/index.html']+sorted(glob.glob('viewer/public/**/index.html',recursive=True)); print('\n'.join(sorted({'sha256-'+base64.b64encode(hashlib.sha256(m.encode()).digest()).decode() for f in files for m in re.findall(r'<script(?:\\s[^>]*)?>(.*?)</script>', open(f).read(), re.DOTALL) if m.strip() and 'src=' not in m[:60]})))"
        #
        # `https://musikersuche.org` is whitelisted in script-src and
        # connect-src so the self-hosted Matomo on the same VPS can load
        # matomo.js (dynamically injected by /matomo-consent.js after
        # the user opts in) and POST tracking pings. Matomo läuft seit
        # 2026-05-21 als externes /matomo-consent.js (Vanilla-JS in
        # viewer/public/) statt inline — Auslöser war das DSGVO/TTDSG-
        # Review: cookieless allein reicht der LfDI-Niedersachsen-
        # Auslegung nicht, ein Opt-in-Banner muss her. Matomos eigene
        # Validator-Heuristik findet die externe Variante per HEAD nicht
        # mehr — Site-ID + Tracker-URL stehen aber unverändert im JS,
        # also klappt die tatsächliche Tracking-POST unbeeinflusst.
        #
        # base-uri 'none': no page uses <base>. form-action 'self': every
        # form (dashboard auth/account, feedback FAB) is fetch()-submitted
        # with preventDefault and has no action attribute. object-src
        # 'none': no plugins/embeds.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://musikersuche.org 'sha256-/Rjptm1kmzXDE21ayZNvF13Jr8eeeB1GCC7E+blw22M=' 'sha256-/gdDniXAIkHcPDpq4S6yIt9GGOeB37M9LuO6MybaAb4=' 'sha256-08X8wE9yg9KtPEKMZBl4q7ELkEGaPZ4k8lDJA4DTSrs=' 'sha256-0B+nMzz8DRUoATuWTJFNH3hGR3vd644wX/yfufRl6ow=' 'sha256-24y91Twgb2b5KKP3rdeLNaYm8hXGVTTAk8363bruuKE=' 'sha256-4U2n28UprNIvU19ZkqpDdv0F3UsmyKoVX6RCZp0Y8vk=' 'sha256-59+dMe55VlaHexbR0i8/SgYRcXS31MncNibklgCGmCI=' 'sha256-8lLCeTD7IoHSI40mKwqxHxSTpl+4u6Q1CrJxHBsq6jI=' 'sha256-BJTiVvkiF6CzAvG8s+gft2099rBGpPnTtE4z9gEiqYY=' 'sha256-DU0PJDad2PEIQq+K0uhUovmPA9HFVA0nTQXRNIsMS9w=' 'sha256-EMGV5yNmZEp5xplZZCXmtHK4q2vOGjDIAyCt8fhwRE0=' 'sha256-FhHWK9nn59SWZcSQ+W3DGLdl7iZA5s8D+BhxyilwHWs=' 'sha256-GZ8K8r4r2qxfCu7sDCAyPitkxkbphaaUhuSY1NlS2Pk=' 'sha256-GsCPSjSfNlaIvfnf8JWiXtet9QHRNlJP+El+ibQq4rw=' 'sha256-IRzRHUSSUhT4CdNiyd/Hy7xyuC4LNoO+EPmoKQEs5CU=' 'sha256-J4A4kjyogNxlegiIDVv7QJkqhrO35TIu2IqKkPxhgxQ=' 'sha256-JZwB8GL9+QW6+qVq+c+GsSWpZgWJcgVj4KVbVicTytA=' 'sha256-N1iNkXPu1uAi8vIxf57hWirBPFxOp/hkWQK8EW8TdxI=' 'sha256-NIOoGGNUBvRqOqhjbdOe26ez6QKH7BkxR4VuEg1CyXU=' 'sha256-RENr2107xiN5NQAtzpTyYZH40H3rLz32CZzXOnhMlvw=' 'sha256-S04wBwtS60mXXgdDx2Td+EyAlbYfQSsDMizH//YwZvQ=' 'sha256-TA4HmQUdI7hL8A/SAkwxDhHTZQ84uYJ5COKeVk/7Ns4=' 'sha256-THE+tpIPKDKMyxdvB5IEWPx0mBa84dD4/GpRhTtDRbQ=' 'sha256-U2ktHjFdybLwuE/715NWNY1s0m3BDlAHjVWPvf0aCfY=' 'sha256-XxOR1JZITelbZA4gPYa1rzirvKPmNqkxaXkspG/Q4ZI=' 'sha256-beCErR6CrdYXuJeN+6sWGPPm4/thogsrn8zSLRrNuc8=' 'sha256-blIs5uRFnjFprneG23UvE5y1WoC/VSzUmbJHcKbmCiw=' 'sha256-d9C2GiomBB+Er3X3gOqOE6srxSmqJEZlIhHJ7AOzmo8=' 'sha256-ecib+dnaHnW55iXhQ6bacmdUN8a9FOlk0Gcmat9ION8=' 'sha256-fkK53U7TLudgA0+a4PrPywRQ/+G/6R5rKb5D1EW4T48=' 'sha256-fs4YzE+kF+rTOVHRRMQ5TMXf9z3Q0jxYxiC70Cdy9Ww=' 'sha256-hgqRZUljTYea1Jbnb2Lvc4MreDWVlVr0YvhKiVvlGyg=' 'sha256-iNImSegNNr5BdZXryzoCpdERwAkSmQVZH82SmSi2MUw=' 'sha256-igrI+h8UcYsp5A6dvLvTmV/+rrtqhLZEmptWDSakcIs=' 'sha256-jwqtQH7wY3hkkOBNL8sl+f7rFJSiN66RFoen0NEdoJI=' 'sha256-nKKBFq898dPtWKOzgbsGWywDTeaLK9QYv7rTcuGlNEo=' 'sha256-ocTQdYvhO8I8nz+OhSAS5JjKpZ7fCfPU+vYVpY4oO4M=' 'sha256-p4mLaivvhgSPF2Cf+CiGtHEQBdkwyQWLToAGcACK7f0=' 'sha256-pq8tFRW31zFZwEbqwR0uu0qb76TsS/EBpUdFONEvKxA=' 'sha256-pwN6tHOQbWFxMniXvu+6E5tU1SlMs0L99wl6OtvOfoE=' 'sha256-rdEzGSV4kC3Qub4pHpUhAxc3fVlILMSo0rF+ONRamco=' 'sha256-rttxL0Rm6Wmu8QB+7SbvW8OZy/BloFqR7LM4IZDEuwc=' 'sha256-uFtzXqCSoQyZRYCp5MIA2zV8niy/dJUiBK6JYJcjHD4=' 'sha256-uSWLZAQERKMNAZyAazNL8sZh+6neuPsedrY1NYsyaAM=' 'sha256-vl9PFjrujkF8BAl0yKBapbYceOX0HzfumE0ZNzKwQEc=' 'sha256-voCEe591yJ3LA5UU7tvqUdVUCsse0EvRrCm8vdvErac=' 'sha256-wrSnArs4NCmX0TIGlpL+dtYdktnTy4fmhC896mheyzU=' 'sha256-wuDaiBLQGURq0JBJSBq9mIzSZhWMkogx6Pai/C/57Rs=' 'sha256-yTy0s1+Qz+GW7mDDpdFuUiZLpnuHjHjlzI2YvVNhqKA=' 'sha256-ygvM/dXuLV4+lPaZBeaGmix8SA1+wKKrMxhNB8eRgWs='; style-src 'self'; connect-src 'self' https://musikersuche.org wss://auffi.app wss://turn.auffi.app:5349; img-src 'self' data:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none';"
    }

    # CORP stops other origins from embedding our responses via no-cors
    # loads (<img>, <script>, …) — XS-leak / Spectre hardening. Outside the
    # header {} block because it needs a matcher: og-image.png stays
    # embeddable for link-preview clients that load it in a browser context
    # (server-side crawler fetches ignore CORP either way).
    @corp_same_origin not path /og-image.png
    header @corp_same_origin >Cross-Origin-Resource-Policy "same-origin"

    # reverse_proxy adds `Via: 1.1 Caddy` — needless fingerprinting. Kept
    # out of the block above: a deletion defers the whole header block.
    header -Via

    # Bot prevention — Liste enthält NUR eindeutige Angreifer-/
    # Scrape-Tools, NICHT die generischen Substrings `bot`,
    # `crawler`, `spider`. Diese drei matchen jeden legit
    # Search-Engine-Crawler (Googlebot, bingbot, DuckDuckBot,
    # AhrefsBot, LinkedInBot, Twitterbot, facebookexternalhit …) und
    # haben in der ursprünglichen Fassung den 2026-05-14-SEO-Outage
    # ausgelöst — Search Console konnte nicht crawlen.
    # Excludes /healthz and /readyz so deploy-scripts using curl still work.
    @scrapers {
        header_regexp User-Agent (?i)(scrapy|wget|curl|headlesschrome|phantomjs|nikto|sqlmap|sqlninja|nmap|masscan|metasploit|dirbuster|nuclei|wpscan)
        not path /healthz
        not path /readyz
    }
    handle @scrapers {
        respond "Forbidden" 403
    }

    # Rate limiting per IP.
    # /signal (WebSocket) is excluded: the WS connection itself is long-lived
    # and app-level per-peer message limits apply inside the backend.
    # /turn-credentials has its own tighter zone (10 req/min, enforced by backend too).
    rate_limit {
        zone auffi_general {
            match {
                not path /signal
                not path /turn-credentials
            }
            key {remote_host}
            events 300
            window 1m
        }
        zone auffi_turn {
            match {
                path /turn-credentials
            }
            key {remote_host}
            events 10
            window 1m
        }
    }

    # Backend WebSocket signaling
    handle /signal {
        reverse_proxy backend:8080
    }

    # TURN credential endpoint
    handle /turn-credentials {
        reverse_proxy backend:8080
    }

    # gh #38: REST API for the dashboard (auth + me + devices +
    # admin). Same backend container as /signal — separate handle
    # block (not handle_path) so the /api prefix is preserved end-
    # to-end. Fastify routes are mounted as /api/auth, /api/devices,
    # /api/me, /api/admin etc.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # gh #38: dashboard SPA. Bundle is built with base="/dashboard/"
    # so internal asset references point at /dashboard/assets/...
    # The dashboard nginx sidecar serves the static dist; Caddy
    # strips /dashboard/ before proxying so nginx sees /assets/...
    handle_path /dashboard/* {
        reverse_proxy dashboard:80
    }
    # Normalise the no-slash /dashboard to /dashboard/. Caddy's
    # bare `handle /dashboard { redir … }` form did not fire next
    # to a `handle_path /dashboard/*` block (Caddy treated the
    # path as a non-matching path glob), so use the named-matcher
    # form which Caddy v2 documents explicitly.
    @dashboard_no_slash path /dashboard
    redir @dashboard_no_slash /dashboard/ permanent

    # Health + readiness probes
    handle /healthz {
        reverse_proxy backend:8080
    }
    handle /readyz {
        reverse_proxy backend:8080
    }

    # Viewer assets (hashed filenames — long-lived caching)
    handle /assets/* {
        root * /srv/viewer
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # SPA fallback — all other paths serve index.html
    handle {
        root * /srv/viewer
        try_files {path} /index.html
        file_server
    }
}
