# Local smoke-test Caddyfile — uses Caddy's internal CA to issue a self-signed
# certificate valid for localhost.  The browser will warn about the cert; that is
# expected and acceptable during a pre-deploy smoke test.
#
# DO NOT use this file in production.  The production Caddyfile is caddy/Caddyfile.

localhost {
    tls internal

    encode zstd gzip

    # Backend WebSocket signaling
    handle /signal {
        reverse_proxy backend:8080
    }

    # TURN credential endpoint
    handle /turn-credentials {
        reverse_proxy backend:8080
    }

    # gh #38 — REST API for the dashboard. Same backend container as
    # /signal; handle (not handle_path) preserves the /api prefix so
    # Fastify's /api/auth /api/devices /api/me /api/admin routes match.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # gh #38 — dashboard SPA. Bundle is built with base="/dashboard/"
    # so internal asset references point at /dashboard/assets/...
    # The dashboard nginx sidecar serves the static dist; Caddy
    # strips /dashboard/ before proxying so nginx sees /assets/...
    handle_path /dashboard/* {
        reverse_proxy dashboard:80
    }
    # Normalise the no-slash /dashboard to /dashboard/. Caddy's bare
    # `handle /dashboard { redir … }` form didn't fire here (Caddy
    # treated the path as a non-matching path glob), so we use the
    # named-matcher form which Caddy v2 documents explicitly.
    @dashboard_no_slash path /dashboard
    redir @dashboard_no_slash /dashboard/ permanent

    # Health + readiness probes
    handle /healthz {
        reverse_proxy backend:8080
    }
    handle /readyz {
        reverse_proxy backend:8080
    }

    # Viewer assets (hashed filenames — long-lived caching)
    handle /assets/* {
        root * /srv/viewer
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # SPA fallback — all other paths serve index.html
    handle {
        root * /srv/viewer
        try_files {path} /index.html
        file_server
    }
}
