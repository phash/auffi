# Production environment — copy to .env.prod and fill in real values.
# .env.prod is gitignored and must never be committed.

# Backend image tag — set to a specific version or commit SHA for pinned deploys.
APP_VERSION=

# TURN relay shared secret — generate with: openssl rand -hex 32
TURN_SHARED_SECRET=

# TURN realm (must match coturn turnserver.conf and DNS A-record)
TURN_REALM=turn.screenie.mr-development.de

# Comma-separated list of TURN URLs advertised to clients
# Format: scheme:host:port  (scheme: turn | turns)
TURN_HOSTS=turn:turn.screenie.mr-development.de:3478,turns:turn.screenie.mr-development.de:5349

# TURN credential TTL in seconds (max 3600 for free tier; coturn enforces lifetime=600)
TURN_TTL_SEC=3600

# Session TTL in milliseconds (10 min = 600000)
SESSION_TTL_MS=600000

# Signaling brute-force protection
MAX_FAILED_ATTEMPTS=5

# Rate-limiter window + cap for /turn-credentials and /signal
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Origins allowed to open the WebSocket signaling connection
ALLOWED_ORIGINS=https://screenie.mr-development.de

NODE_ENV=production
