# Production environment — copy to .env.prod and fill in real values.
# .env.prod is gitignored and must never be committed.

# Backend image tag — set to a specific version or commit SHA for pinned deploys.
APP_VERSION=

# TURN relay shared secret — generate with: openssl rand -hex 32
TURN_SHARED_SECRET=

# TURN realm (must match coturn turnserver.conf and DNS A-record)
TURN_REALM=turn.screenie.mr-development.de

# Comma-separated list of TURN URLs advertised to clients
# Format: scheme:host:port  (scheme: turn | turns)
TURN_HOSTS=turn:turn.screenie.mr-development.de:3478,turns:turn.screenie.mr-development.de:5349

# TURN credential TTL in seconds (max 3600 for free tier; coturn enforces lifetime=600)
TURN_TTL_SEC=3600

# coturn listening / advertised IPv4. REQUIRED on cloud VPS where the
# public IPv4 is bound /32 to a single interface — coturn's libc-based
# interface autodetect silently skips those, leaves the relay unreachable
# from outside, and every connection falls back to "no working transport"
# (see docs/postmortem-2026-05-13-connectivity.md). Leave empty for
# home-server topologies where coturn's autodetect works fine.
TURN_LISTENING_IP=
TURN_EXTERNAL_IP=

# Session TTL in milliseconds (10 min = 600000)
SESSION_TTL_MS=600000

# Signaling brute-force protection
MAX_FAILED_ATTEMPTS=5

# Rate-limiter window + cap for /turn-credentials and /signal
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Origins allowed to open the WebSocket signaling connection.
# REQUIRED: set to your deployment's public origin(s), comma-separated.
# A wrong value here silently 403s every viewer WebSocket. e.g. https://auffi.app
ALLOWED_ORIGINS=https://auffi.app

# ── SMTP (gh #39) ────────────────────────────────────────────────────
# Outgoing mail for the unattended-mode account flows: verify-email
# on signup, password-reset, email-change confirmation. The backend
# uses these via nodemailer (see backend/src/email/transport.ts).
#
# Behaviour matrix:
#   • SMTP_* unset       → backend logs a warning, falls back to the
#                           in-memory "capture" transport. Signups
#                           succeed but no mail is delivered — handy
#                           for local dev; disastrous in prod.
#   • SMTP_HOST + creds  → real nodemailer transport.
#
# Generate an app-specific password for the from-address on your
# SMTP provider (e.g. mailbox.org, fastmail, sendgrid) — don't use a
# personal mailbox login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM is what appears in the From: header. Most providers
# reject mails whose From: doesn't match the authenticated user, so
# keep it equal to SMTP_USER unless your provider explicitly allows
# subaddressing.
SMTP_FROM=
# Plaintext-only mail bodies (see backend/src/email/templates.ts);
# the link inside each mail derives from this base URL. Defaults to
# https://auffi.app/dashboard when unset — set explicitly for self-
# hosted deployments under a different domain.
DASHBOARD_URL=
# ── Account signup gate (gh #39) ─────────────────────────────────────
# Set SIGNUP_DISABLED=1 to close public registration (POST
# /api/auth/signup returns 403). Login + password-reset stay open, so
# existing accounts keep working. Leave unset/empty to allow signups.
# Handy for a single-tenant self-host where you create the one admin
# account, then lock the door.
SIGNUP_DISABLED=

# Bootstrap a single admin account on backend startup. The named
# account must already exist (sign up first via the dashboard) —
# the env-var just flips the `admin` flag on the existing row.
# Leave unset to keep every account non-admin (no /api/admin/*
# access — see backend/src/admin/bootstrap.ts).
INITIAL_ADMIN_EMAIL=

# Path where the SQLite DB is written. Maps to the auffi-db
# named volume inside the container (docker-compose.prod.yml).
# Override only if you mount the volume elsewhere.
AUFFI_DB_PATH=/var/lib/auffi/auffi.db

# Per-IP cap on sharer `register`-as-sharer messages on /signal.
# Defaults to 5 per minute — raise only if a single NAT'd network
# legitimately hosts many concurrent sharer apps.
REGISTER_RATE_LIMIT_WINDOW_MS=60000
REGISTER_RATE_LIMIT_MAX=5

NODE_ENV=production
