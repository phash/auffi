# Backend environment variables (copy to .env and adjust)

# Session time-to-live in milliseconds (default: 600000 = 10 minutes)
SESSION_TTL_MS=600000

# Maximum failed join attempts before a session is burned (default: 5)
MAX_FAILED_ATTEMPTS=5

# Rate-limit sliding window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum join attempts per IP per window before rate-limit error (default: 5)
RATE_LIMIT_MAX=5

# Comma-separated list of allowed WebSocket upgrade Origins (default: localhost dev ports)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://127.0.0.1
