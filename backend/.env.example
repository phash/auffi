# Backend environment variables (copy to .env and adjust)

# Session time-to-live in milliseconds (default: 600000 = 10 minutes)
SESSION_TTL_MS=600000

# Rate-limit sliding window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum join attempts per IP per window before rate-limit error (default: 5)
RATE_LIMIT_MAX=5

# Comma-separated list of allowed WebSocket upgrade Origins (default: localhost dev ports)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://127.0.0.1

# TURN relay credentials (coturn use-auth-secret mode)
# If unset, the /turn-credentials endpoint is disabled (acceptable in local dev without coturn)
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=

# TURN realm — must match the realm in turnserver.conf
TURN_REALM=turn.auffi.local

# Comma-separated TURN/TURNS URLs served to clients.
# Format: <scheme>:<host>:<port>[,<scheme>:<host>:<port>...]
# Example: turn:turn.auffi.app:3478,turns:turn.auffi.app:5349
TURN_HOSTS=turn:turn.auffi.local:3478,turns:turn.auffi.local:5349

# Credential lifetime in seconds (default: 3600 = 1 hour). Must be ≤ coturn lifetime setting.
TURN_TTL_SEC=3600
