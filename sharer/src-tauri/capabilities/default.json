{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Screenie sharer — allow webview to invoke Rust commands, listen to events emitted by Rust, and use the dialog plugin for file pickers.",
  "windows": ["main", "border"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:app:default",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "store:default",
    "shell:allow-open"
  ]
}
