{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Auffi sharer — minimum set required for screen-share + dialog + pause-hotkey + settings store. The webview can only open https:// links to the project's About-page targets via the shell plugin.",
  "windows": ["main", "border"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:app:default",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "store:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://buymeacoffee.com/phash" },
        { "url": "https://phash.de" },
        { "url": "https://mr-development.de" },
        { "url": "https://auffi.app/**" }
      ]
    }
  ]
}
