# Use a fuller Ubuntu image so apt-installed deps and system tools work correctly.
# The slim/micro catthehacker images do not have all packages available.
-P ubuntu-24.04=catthehacker/ubuntu:act-24.04
-P ubuntu-latest=catthehacker/ubuntu:act-24.04
# Windows and macOS jobs cannot run under act; skip them with --matrix os:ubuntu-24.04
