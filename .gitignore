# Local act secrets — never commit credentials
.secrets

# Locally-staged release artefacts (binaries, not source). packaging/ holds
# Windows .exe/.msi build outputs that are uploaded to the GitHub release;
# packaging/arch/PKGBUILD is the only tracked thing under it.
release-bin/
packaging/*.exe
packaging/*.msi
packaging/Version_*/

# Playwright run artefacts — traces/screenshots, never source
test-results/
viewer/test-results/

# Local screenshots — manuel's personal capture dir
screens/

# Claude Code session-local state (lockfile etc.)
.claude/

# Superpowers brainstorming mockups — local, never committed
.superpowers/

# Diagnostic logs pasted in for support. They carry raw IPs in the turn-crate
# debug lines (our own dbg_log redacts, the library's does not), so they must
# never be committed.
auffi-debug*.log
Textdokument*.txt
*-debug.log
